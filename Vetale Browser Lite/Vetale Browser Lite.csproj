<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Vetale_Browser_Lite</RootNamespace>
    <AssemblyName>Vetale Browser Lite</AssemblyName>
    <ApplicationIcon>Icons\DefaultTabItem.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Description>Vetale Browser SuperLite</Description>
    <Company>Vetale</Company>
    <Product>Vetale Browser Lite</Product>
    <Copyright>Copyright © 2026</Copyright>
    <!-- CefSharp supports x64 only in this project (no AnyCPU) -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseAppHost>true</UseAppHost>
    <StartupObject>Vetale_Browser_Lite.App</StartupObject>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Latest Chromium line (CEF 151.3.24 / Chromium 151.0.7922.174). NETCore flavour targets modern .NET (incl. .NET 10). -->
    <PackageReference Include="CefSharp.Wpf.NETCore" Version="151.3.240" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Icons\**" />
  </ItemGroup>

</Project>
