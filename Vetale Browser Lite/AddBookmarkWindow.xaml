<Window x:Class="Vetale_Browser_Lite.AddBookmarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Title_AddBookmark}" Width="440" Height="270"
        MinWidth="360" MinHeight="240"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderBrush="#30000000" BorderThickness="1" CornerRadius="10" Background="{StaticResource GrayGradient}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar (like MainWindow) -->
            <Border Grid.Row="0" Background="Transparent" CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Image Source="pack://application:,,,/Icons/AddBookmarkButton.png"
                               Width="18" Height="18" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock FontSize="14" FontWeight="Bold" VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.25" Color="#80808080"/>
                            </TextBlock.Effect>
                            <Run Text="{DynamicResource Add_TitleA}" Foreground="{StaticResource TitleOrangeBrush}"/>
                            <Run Text="{DynamicResource Add_TitleB}" Foreground="{StaticResource TitlePurpleBrush}"/>
                        </TextBlock>
                    </StackPanel>
                    <Button Tag="pack://application:,,,/Icons/CloseButton.png"
                            HorizontalAlignment="Right" Margin="0,5,8,5"
                            Click="CloseButton_Click" Style="{StaticResource DialogTitleCloseButtonStyle}"/>
                </Grid>
            </Border>

            <!-- Purple band with fields (like nav bar) -->
            <Border Grid.Row="1" Background="{StaticResource PurpleGradient}" BorderBrush="#30000000"
                    BorderThickness="0,1,0,1" Margin="8,0" CornerRadius="6">
                <StackPanel Margin="14,10">
                    <TextBlock Text="{DynamicResource Label_Name}" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="TitleBox" Style="{StaticResource DialogTextBoxStyle}"/>
                    <TextBlock Text="{DynamicResource Label_Url}" Foreground="White" FontWeight="SemiBold" Margin="0,10,0,4"/>
                    <TextBox x:Name="UrlBox" Style="{StaticResource DialogTextBoxStyle}"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,8,12,10">
                <Button Content="{DynamicResource Btn_Save}" Click="SaveButton_Click" IsDefault="True" Style="{StaticResource DialogPrimaryButtonStyle}"/>
                <Button Content="{DynamicResource Btn_Cancel}" Click="CloseButton_Click" IsCancel="True" Style="{StaticResource DialogSecondaryButtonStyle}" Margin="0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
