<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Same palette as MainWindow -->
    <LinearGradientBrush x:Key="GrayGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFE0E0E0" Offset="0"/>
        <GradientStop Color="#FFD0D0D0" Offset="0.3"/>
        <GradientStop Color="#FFC5C5C5" Offset="0.7"/>
        <GradientStop Color="#FFC0C0C0" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PurpleGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFA020F0" Offset="0"/>
        <GradientStop Color="#FF9A1CE8" Offset="0.3"/>
        <GradientStop Color="#FF8E15DC" Offset="0.7"/>
        <GradientStop Color="#FF8612D0" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TitleOrangeBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFF9500" Offset="0"/>
        <GradientStop Color="#FFFF5E00" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TitlePurpleBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFB14BF4" Offset="0"/>
        <GradientStop Color="#FF7C1FD6" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="DialogLabelBrush" Color="#4C1D95"/>
    <SolidColorBrush x:Key="DialogFieldBackground" Color="#F3E8FF"/>
    <SolidColorBrush x:Key="DialogFieldBorder" Color="#A78BFA"/>

    <!-- Primary (orange) dialog button -->
    <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="100"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Background" Value="#FFFF6D00"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="12,0"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFFF8800"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#FFE45500"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Secondary (white/purple outline) dialog button -->
    <Style x:Key="DialogSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogPrimaryButtonStyle}">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#FF7C3AED"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6"
                            BorderBrush="#FFA78BFA" BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="12,0"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFF5F3FF"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#FFEBE4FF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ✕ close button in dialog title bars — same look as MainWindow (icon, red on hover) -->
    <Style x:Key="DialogTitleCloseButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="6" SnapsToDevicePixels="True">
                        <Image Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#40FF5C5C"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Text fields -->
    <Style x:Key="DialogTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource DialogFieldBackground}"/>
        <Setter Property="Foreground" Value="#4C1D95"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Padding="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource DialogFieldBorder}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Lists (history / bookmarks) -->
    <Style x:Key="DialogListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#4C1D95"/>
        <Setter Property="BorderBrush" Value="#FFA78BFA"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="6"/>
    </Style>

</ResourceDictionary>
