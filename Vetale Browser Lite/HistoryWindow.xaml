<Window x:Class="Vetale_Browser_Lite.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Vetale_Browser_Lite.Wpf"
        Title="{DynamicResource Title_History}" Width="640" Height="480"
        MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/DialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <wpf:BytesToImageSourceConverter x:Key="FaviconConverter"/>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderBrush="#30000000" BorderThickness="1" CornerRadius="10" Background="{StaticResource GrayGradient}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar (like MainWindow) -->
            <Border Grid.Row="0" Background="Transparent" CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Image Source="pack://application:,,,/Icons/HistoryButton.png"
                               Width="18" Height="18" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock FontSize="14" FontWeight="Bold" VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.25" Color="#80808080"/>
                            </TextBlock.Effect>
                            <Run Text="{DynamicResource History_TitleA}" Foreground="{StaticResource TitleOrangeBrush}"/>
                            <Run Text="{DynamicResource History_TitleB}" Foreground="{StaticResource TitlePurpleBrush}"/>
                        </TextBlock>
                    </StackPanel>
                    <Button Tag="pack://application:,,,/Icons/CloseButton.png"
                            HorizontalAlignment="Right" Margin="0,5,8,5"
                            Click="CloseButton_Click" Style="{StaticResource DialogTitleCloseButtonStyle}"/>
                </Grid>
            </Border>

            <!-- Purple band + white content (like nav bar + browser area) -->
            <Border Grid.Row="2" Background="{StaticResource PurpleGradient}" BorderBrush="#30000000"
                    BorderThickness="0,1,0,1" Margin="8,0" CornerRadius="6">
                <Border Background="White" CornerRadius="6" Margin="8,6" ClipToBounds="True">
                    <ListBox x:Name="HistoryList"
                             MouseDoubleClick="HistoryList_MouseDoubleClick"
                             Style="{StaticResource DialogListBoxStyle}"
                             BorderThickness="0" Margin="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4">
                                    <Image Width="20" Height="20" Margin="0,0,10,0"
                                           Source="{Binding Favicon, Converter={StaticResource FaviconConverter}}"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           SnapsToDevicePixels="True"/>
                                    <TextBlock Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,8,12,10">
                <Button Content="{DynamicResource Btn_Clear}" Click="ClearButton_Click" Style="{StaticResource DialogSecondaryButtonStyle}"/>
                <Button Content="{DynamicResource Btn_Open}" Click="OpenButton_Click" Style="{StaticResource DialogPrimaryButtonStyle}"/>
                <Button Content="{DynamicResource Btn_Close}" Click="CloseButton_Click" Style="{StaticResource DialogSecondaryButtonStyle}" Margin="0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
