<Window x:Class="Vetale_Browser_Lite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cefSharp="clr-namespace:CefSharp.Wpf;assembly=CefSharp.Wpf"
        xmlns:wpf="clr-namespace:Vetale_Browser_Lite.Wpf"
        Title="Vetale Browser Super Lite"
        Width="1200" Height="800"
        MinHeight="320" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Background="Transparent"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Gradients -->
        <LinearGradientBrush x:Key="GrayGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFE0E0E0" Offset="0"/>
            <GradientStop Color="#FFD0D0D0" Offset="0.3"/>
            <GradientStop Color="#FFC5C5C5" Offset="0.7"/>
            <GradientStop Color="#FFC0C0C0" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PurpleGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFA020F0" Offset="0"/>
            <GradientStop Color="#FF9A1CE8" Offset="0.3"/>
            <GradientStop Color="#FF8E15DC" Offset="0.7"/>
            <GradientStop Color="#FF8612D0" Offset="1"/>
        </LinearGradientBrush>

        <!-- Title text gradients (orange → purple) -->
        <LinearGradientBrush x:Key="TitleOrangeBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFF9500" Offset="0"/>
            <GradientStop Color="#FFFF5E00" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TitlePurpleBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFB14BF4" Offset="0"/>
            <GradientStop Color="#FF7C1FD6" Offset="1"/>
        </LinearGradientBrush>

        <!-- Language buttons: orange → purple -->
        <LinearGradientBrush x:Key="LanguageButtonBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFF8C00" Offset="0"/>
            <GradientStop Color="#FF9A1CE8" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="LanguageButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Background" Value="{StaticResource LanguageButtonBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Colors -->
        <SolidColorBrush x:Key="NavigationButtonBackground" Color="#FF6D00"/>
        <SolidColorBrush x:Key="NavigationButtonHover" Color="#FF8800"/>
        <SolidColorBrush x:Key="IconButtonBackground" Color="#20A78BFA"/>
        <SolidColorBrush x:Key="IconButtonHover" Color="#50FFFFFF"/>
        <SolidColorBrush x:Key="AddressBarBackground" Color="#F3E8FF"/>
        <SolidColorBrush x:Key="AddressBarForeground" Color="#4C1D95"/>
        <SolidColorBrush x:Key="AddressBarFocusBorder" Color="#A78BFA"/>

        <!-- Button Styles -->
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Background" Value="{StaticResource NavigationButtonBackground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="5" SnapsToDevicePixels="True">
                            <Image Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource NavigationButtonHover}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <wpf:GdiBitmapToImageSourceConverter x:Key="GdiBitmapToImageSourceConverter" />

        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="8" SnapsToDevicePixels="True">
                            <Image Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#40FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#40FF5C5C"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AddressBarStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource AddressBarBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource AddressBarForeground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                        Padding="{TemplateBinding Padding}"
                                        VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AddressBarFocusBorder}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#30000000" BorderThickness="1" CornerRadius="10" Background="{StaticResource GrayGradient}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="Transparent" CornerRadius="10,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <Image Source="pack://application:,,,/Icons/VetaleSearchIcon.png"
                                   Width="20" Height="20" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock FontSize="14" FontWeight="Bold" VerticalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.25" Color="#80808080"/>
                                </TextBlock.Effect>
                                <Run Text="Vetale " Foreground="{StaticResource TitleOrangeBrush}"/>
                                <Run Text="Browser " Foreground="{StaticResource TitlePurpleBrush}"/>
                                <Run Text="Super " Foreground="{StaticResource TitleOrangeBrush}"/>
                                <Run Text="Lite" Foreground="{StaticResource TitlePurpleBrush}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button x:Name="LangUkButton" Content="УК" Tag="uk" Style="{StaticResource LanguageButtonStyle}" Click="LanguageButton_Click"/>
                        <Button x:Name="LangEnButton" Content="EN" Tag="en" Style="{StaticResource LanguageButtonStyle}" Click="LanguageButton_Click"/>
                        <Button x:Name="LangDeButton" Content="DE" Tag="de" Style="{StaticResource LanguageButtonStyle}" Click="LanguageButton_Click"/>
                        <Button x:Name="LangRuButton" Content="RU" Tag="ru" Style="{StaticResource LanguageButtonStyle}" Click="LanguageButton_Click"/>
                        <Button x:Name="LangTrButton" Content="TR" Tag="tr" Style="{StaticResource LanguageButtonStyle}" Click="LanguageButton_Click" Margin="0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeButton" 
                                Tag="pack://application:,,,/Icons/MinButton.png"
                                Click="MinimizeButton_Click"
                                Style="{StaticResource WindowControlButtonStyle}"/>
                        <Button x:Name="MaximizeRestoreButton" 
                                Tag="pack://application:,,,/Icons/MaxButton.png"
                                Click="MaximizeButton_Click"
                                Style="{StaticResource WindowControlButtonStyle}"/>
                        <Button x:Name="CloseButton" 
                                Tag="pack://application:,,,/Icons/CloseButton.png"
                                Click="CloseButton_Click"
                                Style="{StaticResource WindowCloseButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Navigation Bar -->
            <Border Grid.Row="1" Background="{StaticResource PurpleGradient}" BorderBrush="#30000000" BorderThickness="0,1,0,1" Margin="8,0" CornerRadius="6">
                <Grid Margin="10,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BackButton" 
                            Tag="pack://application:,,,/Icons/Backbutton.png"
                            Style="{StaticResource NavigationButtonStyle}"/>
                    <Button x:Name="ForwardButton" Grid.Column="1"
                            Tag="pack://application:,,,/Icons/ForwardButton.png"
                            Style="{StaticResource NavigationButtonStyle}"/>
                    <Button x:Name="RefreshButton" Grid.Column="2"
                            Tag="pack://application:,,,/Icons/ReloadTabButton.png"
                            Style="{StaticResource NavigationButtonStyle}"/>
                    <Button x:Name="HistoryButton" Grid.Column="3"
                            Tag="pack://application:,,,/Icons/HistoryButton.png"
                            ToolTip="{DynamicResource Tip_History}"
                            Style="{StaticResource NavigationButtonStyle}"/>
                    <Button x:Name="HomeButton" Grid.Column="4"
                            Tag="pack://application:,,,/Icons/HomeButton.png"
                            ToolTip="{DynamicResource Tip_Home}"
                            Style="{StaticResource NavigationButtonStyle}"/>
                    <Button x:Name="AddBookmarkButton" Grid.Column="5"
                            Tag="pack://application:,,,/Icons/AddBookmarkButton.png"
                            ToolTip="{DynamicResource Tip_AddBookmark}"
                            Style="{StaticResource NavigationButtonStyle}"/>
                    <Button x:Name="BookmarksButton" Grid.Column="6"
                            Tag="pack://application:,,,/Icons/InstrumensButton.png"
                            ToolTip="{DynamicResource Tip_Bookmarks}"
                            Style="{StaticResource NavigationButtonStyle}"/>

                    <TextBox x:Name="AddressBar" Grid.Column="8" 
                             Style="{StaticResource AddressBarStyle}"/>

                    <Button x:Name="GoButton" Grid.Column="9" 
                            Content="→" 
                            Width="52" Height="30"
                            Margin="6,0,0,0"
                            Background="White"
                            Foreground="#7C3AED"
                            BorderThickness="0"
                            FontSize="15"
                            FontWeight="Bold"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F5F3FF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Browser Content -->
            <Border Grid.Row="2" Background="White" CornerRadius="0,0,10,10" Margin="8,0,8,8" ClipToBounds="True">
                <cefSharp:ChromiumWebBrowser x:Name="Browser"/>
            </Border>
        </Grid>
    </Border>
</Window>
